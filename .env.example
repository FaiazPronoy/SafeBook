# Copy this file to .env and fill both values in.
# `python manage.py new_keys --write` fills both in for you.
#
# .env is in .gitignore. If a real key ever reaches a commit, rotating it is
# the fix - deleting the file is not, because git keeps the old copy.
SECRET_KEY=put-a-long-random-string-here
APP_KEK_BASE64=put-32-random-bytes-base64-encoded-here

# Which KEK generation is in use. `manage.py rotate_kek` bumps this for you.
KEYMGMT_ACTIVE_KEK_ID=1

# Local development only. Leave this out in production.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
